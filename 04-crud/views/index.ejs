<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CICO tracker · 3 good things</title>
  <!-- Bootstrap 5 (no custom CSS, no inline styles) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

  <!-- main landing container -->
  <div class="container py-5 my-4">

    <!-- header -->
    <div class="row text-center mb-5">
      <div class="col-12">
        <h1 class="display-4 fw-normal">Welcome <%= name %> to CICO tracker</h1>
        <p class="lead text-muted">Three things that make it work for you</p>
        <hr class="w-25 mx-auto">
      </div>
    </div>

    <!-- three good things (cards) -->
    <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">

      <!-- 1. clarity -->
      <div class="col">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body text-center p-4">
            <div class="display-5 text-primary mb-3">📊</div>
            <h3 class="card-title h5">Crystal‑clear overview</h3>
            <p class="card-text text-muted">
              See your daily calories in and out at a glance. No clutter, 
              no guesswork — just the numbers that matter.
            </p>
          </div>
        </div>
      </div>

      <!-- 2. actionable -->
      <div class="col">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body text-center p-4">
            <div class="display-5 text-success mb-3">🎯</div>
            <h3 class="card-title h5">Actionable insights</h3>
            <p class="card-text text-muted">
              Know exactly where you stand. The tracker highlights surplus 
              or deficit, so you can adjust your day — instantly.
            </p>
          </div>
        </div>
      </div>

      <!-- 3. progress -->
      <div class="col">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body text-center p-4">
            <div class="display-5 text-warning mb-3">📈</div>
            <h3 class="card-title h5">Progress, not perfection</h3>
            <p class="card-text text-muted">
              Log consistently and watch your trends. The tracker helps 
              you build the habit, not obsess over one day.
            </p>
          </div>
        </div>
      </div>

    </div> <!-- /row -->

    <!-- extra call-to-action / social proof (still no inline style) -->
    <div class="row mt-5 pt-4 text-center">
      <div class="col-12">
        <div class="bg-light p-4 rounded-3">
          <p class="mb-2 fw-semibold">✨ Start tracking with confidence</p>
          <p class="text-muted small">Used by thousands — free, simple, and private.</p>
          <a href="#" class="btn btn-outline-primary btn-sm px-4">Learn more</a>
        </div>
      </div>
    </div>

    <!-- footer (optional) -->
    <div class="row mt-5">
      <div class="col-12 text-center text-muted small">
        <p class="border-top pt-3 mb-0">© <%= new Date() %> · CICO tracker · three good things</p>
      </div>
    </div>

  </div> <!-- /container -->

  <!-- Bootstrap JS bundle (optional for interactions, not required for layout) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>