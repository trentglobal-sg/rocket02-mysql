<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <div class="container">
        <h1>Create Food Entry</h1>
        <!-- by default, the form is submitted to the same URL it is shown at -->
        <form method="POST">
            <div>
                <label class="form-label">
                    Food Name
                </label>
                <input class="form-control" type="text" name="foodName" />
            </div>
            <div>
                <label class="form-label">Calories</label>
                <input class="form-control" type="number" name="calories" />
            </div>
            <div>
                <label>Meal Type:</label>
                <% for (let m of meals) { %>
                    <input type="radio" name="meal_id" value="<%= m.id %>" id="meal-<%=m.id %>" />
                    <label for="meal-<%=m.id %>"><%= m.name %></label>
                <% } %>
               
            </div>
            <div>
                <label class="form-label">Tags</label>

                <% for (let t of tags) { %>
                    <input type="checkbox" name="tags[]" value="<%= t.id %>" /><label><%= t.name %></label>
                <% } %>

            </div>
            <div>
                <label class="form-label">Serving Size</label>
                <input class="form-control" type="number" name="servingSize" />
            </div>
            <div>
                <label class="form-label">Unit</label>
                <input class="form-control" type="text" name="unit" />
            </div>
            <input type="submit" class="mt-3 btn btn-primary"/>
        </form>
    </div>

</body>

</html>