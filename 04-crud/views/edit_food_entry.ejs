<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <div class="container">
        <h1>Edit Food Entry</h1>
        <!-- by default, the form is submitted to the same URL it is shown at -->
        <form method="POST">
            <div>
                <label class="form-label">
                    Food Name
                </label>
                <input class="form-control" type="text" name="foodName" value="<%= foodEntry.foodName %>" />
            </div>
            <div>
                <label class="form-label">Calories</label>
                <input class="form-control" type="number" name="calories" value="<%= foodEntry.calories %>"/>
            </div>
            <div>
                <label>Meal Type:</label>
                <input type="radio" 
                    name="meal" 
                    value="breakfast" 
                    id="breakfast" 
                    <% if (foodEntry.meal.toLowerCase() == "breakfast") { %>
                        checked
                    <% } %>
                />
                <label for="breakfast">Breakfast</label>

                <input type="radio" 
                    name="meal" 
                    value="lunch" 
                    id="lunch"
                    <%= foodEntry.meal.toLowerCase() == "lunch" ? "checked" : "" %>
                />
                <label for="lunch">Lunch</label>

                <input type="radio" name="meal" value="dinner" id="dinner" 
                    <%= foodEntry.meal.toLowerCase() == "dinner" ? "checked" : "" %>
                />
                <label for="dinner">Dinner</label>

                <input type="radio" name="meal" value="snack" id="snack" 
                    <%= foodEntry.meal.toLowerCase() == "snack" ? "checked" : "" %>
                />
                <label for="snack">Snack</label>
            <div>
                <label class="form-label">Tags</label>
                <input type="checkbox" name="tags[]" value="healthy" 
                 <% if (foodEntry.tags.includes("healthy")) { %>
                    checked
                 <% } %>
                
                /><label>Healthy</label>
                <input type="checkbox" name="tags[]" value="vegan"
                    <%= foodEntry.tags.includes("vegan") ? "checked" : "" %>
                /><label>Vegan</label>
                <input type="checkbox" name="tags[]" value="gluten-free"
                       <%= foodEntry.tags.includes("gluten-free") ? "checked" : "" %>
                /><label>Gluten Free</label>
                <input type="checkbox" name="tags[]" value="organic"
                    <%= foodEntry.tags.includes("organic") ? "checked" : "" %>
                /><label>Organic</label>
            </div>
            <div>
                <label class="form-label">Serving Size</label>
                <input class="form-control" type="number" name="servingSize" value="<%= foodEntry.servingSize %>"/>
            </div>
            <div>
                <label class="form-label">Unit</label>
                <input class="form-control" type="text" name="unit" value="<%= foodEntry.unit %>" />
            </div>
            <input type="submit" class="mt-3 btn btn-primary"/>
        </form>
    </div>

</body>

</html>