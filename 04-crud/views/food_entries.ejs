<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bootstrap demo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>


  <div class="container">
    <h1>Food Entries</h1>
    <a href="/create_food_entry" class="btn btn-primary btn-lg">Create New</a>


  
    <table class="table">
      <thead>
        <tr>
          <th>Recorded When</th>
          <th>Food Name</th>
          <th>Calories</th>
          <th>Meal</th>
          <th>Tags</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% for (let food of results) { %>
          <tr>
            <td>
              <%= food.dateTime.toISOString() %>
            </td>
            <td>
              <%= food.foodName %>
            </td>
            <td>
              <%= food.calories %>
            </td>
            <td>
              <%= food.meal %>
            </td>
            <td><%- food.tags.map(t=> {
                return `<span class="badge text-bg-primary">${t}</span>`
                }) %></td>
            <td>

              <a class="btn btn-success btn-sm" href="/edit_food_entry/<%= food.id %>">Edit</a>

              <a class="btn btn-danger btn-sm" href="/confirm_delete_food_entry/<%= food.id %>">Delete</a>



            </td>
          </tr>
          <% } %>
      </tbody>
    </table>
  </div>

</body>

</html>